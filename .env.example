# ---------------------------------------------------------------------------
# Aether — environment configuration
# NEVER commit a real secret. All values below are placeholders.
# ---------------------------------------------------------------------------

# Data directory (persisted via Docker volume). The SQLite db and secrets live here.
DATA_DIR=./data

# Primary gateway API key. All `/v1` requests must send `Authorization: Bearer <key>`.
GATEWAY_API_KEY=change-me-gateway-key

# Secret used to derive the AES key for encrypting provider credentials at rest.
# MUST be a long random string; do not change after accounts are created, or tokens cannot be decrypted.
GATEWAY_SECRET=change-me-encryption-secret

# Admin token for the management API (`/api/*`). Separate from the gateway key.
GATEWAY_ADMIN_TOKEN=change-me-admin-token

# Time zone used by the scheduler for daily credit claims.
TZ=Asia/Shanghai

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Bind host/port for the HTTP server.
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Container image source for docker compose (read by docker-compose*.yml only).
# Defaults to the post-rename package. To stay on the pre-rename package:
#   GATEWAY_IMAGE_REPO=ghcr.io/xiaonan-520/multi-provider-ai-gateway
# GATEWAY_IMAGE_REPO=ghcr.io/xiaonan-520/aether
#
# Pin a specific build for reproducible deploys, e.g. sha-<commit> or v0.2.0-phase3.
# GATEWAY_IMAGE_TAG=latest
