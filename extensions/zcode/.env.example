PORT=8080
DATA_DIR=/data
LOG_LEVEL=info
# Manager 注入；本地开发可自设
EXTENSION_AUTH_TOKEN=
EXTENSION_ENCRYPTION_KEY=
ZCODE_REQUEST_TIMEOUT_MS=120000
ZCODE_CAPTCHA_WAIT_MS=60000

# ── Captcha 模式 ──
# manual（默认）= 人工交接页；auto = happy-dom 自动求解（ToS/许可风险自担）；off = 关闭
ZCODE_CAPTCHA_MODE=manual
# auto 模式参数（可选）
ZCODE_CAPTCHA_POOL_MIN=5
ZCODE_CAPTCHA_POOL_MAX=20
ZCODE_CAPTCHA_SOLVE_CONCURRENCY=2
ZCODE_CAPTCHA_SOLVE_TIMEOUT_MS=30000
ZCODE_CAPTCHA_CPU_LIMIT_PCT=70
