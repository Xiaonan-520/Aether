# Copy to .env and fill in. Never commit real secrets.
# (values below are placeholders — Manager injects the real token at install)
PORT=3010
HOST=0.0.0.0
DATA_DIR=/data
LOG_LEVEL=info
# [placeholder] the Gateway presents to this extension (NOT a Tencent token).
EXTENSION_AUTH_TOKEN=change-me
# Optional: explicit AES-256 key material for credential storage; when unset a
# key is generated and persisted inside DATA_DIR.
# EXTENSION_ENCRYPTION_KEY=
# Upstream overrides (defaults point at Tencent CodeBuddy CN).
# WORKBUDDYCN_ENDPOINT=https://copilot.tencent.com
# WORKBUDDYCN_DOMAIN=copilot.tencent.com
# WORKBUDDYCN_USER_AGENT=CodeBuddyIDE/1.106.1